{
  "name": "codesys-mcp-server",
  "version": "0.4.0",
  "description": "MCP server for CODESYS V3 PLC development: project automation and CODESYS documentation search.",
  "type": "module",
  "files": [
    "dist/src/",
    "bin/",
    "bridge/bridge.py",
    "bridge/bridge_daemon.py",
    "bridge/bridge_client.py",
    "bridge/bridge_daemon.ps1",
    "bridge/bridge_daemon.cmd",
    "bridge/daemon_monitor.pyw",
    "bridge/warm_projects.example.txt",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "codesys-mcp": "./bin/codesys-mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test && npm run pack:check",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:stdio": "node dist/src/cli.js --stdio",
    "test": "vitest run --testTimeout=20000",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ && node --check scripts/check-package.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.0.0",
    "express": "^4.22.3",
    "minisearch": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.18.0",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "keywords": ["codesys", "plc", "iec-61131-3", "structured-text", "mcp", "automation"],
  "overrides": {
    "qs": "^6.17.1",
    "esbuild": "^0.28.2"
  }
}
