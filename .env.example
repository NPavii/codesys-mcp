PORT=3000
HOST=127.0.0.1

# Required for HTTP: generate at least 32 random bytes (for example, 64 hex chars).
MCP_TOKEN=
# Non-loopback HTTP additionally requires exact Host values, including port.
# HTTP_ALLOWED_HOSTS=mcp.example:3000
# Browser clients are denied unless their exact Origin is listed.
# HTTP_ALLOWED_ORIGINS=https://client.example

# HTTP is read-only by default. Enable these only after a separate risk review.
HTTP_ENABLE_WRITES=false
HTTP_ENABLE_EVAL=false
HTTP_ENABLE_BATCH=false
HTTP_MAX_SESSIONS=16
HTTP_SESSION_TTL_SECONDS=1800
HTTP_RATE_LIMIT_PER_MINUTE=120

OFFICIAL_LOOKUP_ENABLED=true
OFFICIAL_LOOKUP_TIMEOUT_MS=3500
OFFICIAL_LOOKUP_CACHE_TTL_SECONDS=3600
EXTERNAL_MAX_RESPONSE_BYTES=2000000
PDF_SEARCH_ENABLED=true
PDF_DOCS_DIR=docs/pdfs
PDF_MAX_TEXT_CHARS=200000
PDF_MAX_FILE_BYTES=50000000

# --- Project automation bridge ---
# CODESYS_EXE=C:\Program Files\CODESYS\CODESYS V3.5 SP21\CODESYS.exe
CODESYS_PROFILE=CODESYS V3.5 SP21 Patch 1
# CODESYS_BRIDGE_DIR=bridge
CODESYS_BRIDGE_TIMEOUT_MS=240000
CODESYS_BRIDGE_MAX_QUEUE=32
# Defaults to %LOCALAPPDATA%\CodeSYS-MCP\queue on Windows.
# CB_QUEUE_DIR=D:\private\codesys-queue
